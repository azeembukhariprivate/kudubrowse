<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KUDUBROWSE</AssemblyName>
    <RootNamespace>Kudubrowse</RootNamespace>
    <ApplicationIcon>Assets\KUDUBROWSE.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>Kudubrowse.Program</StartupObject>

    <Version>1.1.2</Version>
    <Product>KUDUBROWSE</Product>
    <Company>Azeem Bukhari</Company>
    <Authors>Azeem Bukhari</Authors>
    <Copyright>Copyright © 2026 Azeem Bukhari</Copyright>
    <Description>KUDUBROWSE - a private everyday web browser</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    The screens are built in C# and the themes are XAML files loaded at startup, so the project
    needs no XAML compiler and builds with the plain .NET SDK on any operating system.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Shows web pages with the Edge engine that comes with Windows (BSD licence). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Lets the app ask Windows Hello (PIN, fingerprint, face) before showing a saved password (MIT). -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\*.xaml" LogicalName="Kudubrowse.Themes.%(Filename).xaml" />
    <EmbeddedResource Include="Assets\KUDUBROWSE.ico" LogicalName="Kudubrowse.Assets.KUDUBROWSE.ico" />
    <EmbeddedResource Include="Assets\Readability.js" LogicalName="Kudubrowse.Assets.Readability.js" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The block lists are downloaded by the build (they're not kept in the repository). -->
    <None Include="Lists\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
